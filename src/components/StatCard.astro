---
interface Props {
    title: string;
    value: string;
    desc?: string;
    iconBgColor?: string;
}

const {
    title,
    value,
    desc,
    iconBgColor = "bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400",
} = Astro.props;
---

<div
    class="p-5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm hover:shadow-md transition-all duration-200 flex items-center justify-between"
>
    <div>
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">
            {title}
        </p>
        <h3 class="text-3xl font-bold text-gray-900 dark:text-white">
            {value}
        </h3>
        {
            desc && (
                <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">
                    {desc}
                </p>
            )
        }
    </div>

    <div class={`p-3 rounded-xl ${iconBgColor}`}>
        <slot />
    </div>
</div>
