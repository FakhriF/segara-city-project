---
interface Props {
    title: string;
    link: string;
    desc?: string;
    iconBgColor?: string;
}

const {
    title,
    link,
    desc,
    iconBgColor = "bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400",
} = Astro.props;
---

<a
    href={link}
    class="p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm text-center flex flex-col items-center justify-center"
>
    <div class={`p-3 rounded-xl ${iconBgColor} mb-3`}>
        <slot />
    </div>
    <h4 class="text-2xl font-bold text-gray-900 dark:text-white mb-1">
        {title}
    </h4>
    <p class="text-sm font-medium text-gray-500 dark:text-gray-400">{desc}</p>
</a>
