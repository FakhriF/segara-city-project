---
interface Props {
    vision: string;
}

const { vision } = Astro.props;
---

<div
    class="p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm hover:shadow-md transition-all duration-200 mb-6"
>
    <h3
        class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3"
    >
        <span
            class="text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 p-2.5 rounded-xl"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="1.5em"
                height="1.5em"
                viewBox="0 0 24 24"
            >
                <path d="M0 0h24v24H0z" fill="none"></path>
                <path
                    fill="currentColor"
                    d="M8.1 21.213q-1.825-.788-3.175-2.138T2.788 15.9T2 12t.788-3.9t2.137-3.175T8.1 2.788T12 2t3.9.788t3.175 2.137T21.213 8.1T22 12t-.788 3.9t-2.137 3.175t-3.175 2.138T12 22t-3.9-.788m9.575-3.537Q20 15.35 20 12t-2.325-5.675T12 4T6.325 6.325T4 12t2.325 5.675T12 20t5.675-2.325M7.75 16.25Q6 14.5 6 12t1.75-4.25T12 6t4.25 1.75T18 12t-1.75 4.25T12 18t-4.25-1.75m7.075-1.425Q16 13.65 16 12t-1.175-2.825T12 8T9.175 9.175T8 12t1.175 2.825T12 16t2.825-1.175m-4.237-1.412Q10 12.825 10 12t.588-1.412T12 10t1.413.588T14 12t-.587 1.413T12 14t-1.412-.587"
                ></path>
            </svg>
        </span>
        Visi Utama
    </h3>
    <blockquote
        class="text-lg italic text-gray-700 dark:text-gray-300 border-l-4 border-blue-600 dark:border-blue-500 pl-4 py-1 bg-blue-50/50 dark:bg-blue-900/10 rounded-r-xl"
    >
        &ldquo;{vision}&rdquo;
    </blockquote>
</div>
