---
interface Props {
    label: string;
    accent: string;
    center?: boolean;
    subtitle?: boolean;
}

const { label, accent, center, subtitle = false } = Astro.props;
---

<h2
    class:list={[
        `font-extrabold tracking-tight text-gray-900 dark:text-white`,
        center ? "mb-8 text-center" : "mb-6",
        subtitle ? "text-3xl" : "text-4xl",
    ]}
>
    {label}
    <span class="text-blue-700 dark:text-blue-500"> {accent}</span>
</h2>
