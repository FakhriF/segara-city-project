---
import Layout from "../layouts/Layout.astro";
import CityLandscape from "../assets/images/city-landscape-2031.webp";
import Education from "../assets/images/education.webp";
import Jalan from "../assets/images/jalan-pasir-putih-raya.webp";
import { Image } from "astro:assets";

import { getCollection } from "astro:content";

const allNews = await getCollection("news");
const sortedNews = allNews.sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const headlineNews = sortedNews.filter((n) => n.data.isHeadline).slice(0, 3);
const latestNews = sortedNews.slice(0, 6);

function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString("id-ID", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
}

function badgeClass(category: string): string {
    if (category === "Infrastruktur") return "badge-info";
    if (category === "Sosial") return "badge-warning";
    if (category === "Transportasi") return "badge-secondary";
    if (category === "Ekonomi") return "badge-success";
    if (category === "Pemerintah") return "badge-accent";
    if (category === "Politik & Pemerintahan") return "badge-accent";
    if (category === "Lingkungan") return "badge-success";
    if (category === "Tata Kota") return "badge-info";
    return "badge-ghost";
}
