                        <p
                            class="text-xs text-base-content/50 group-hover:text-primary/70"
                        >
                            Lapor & aspirasi
                        </p>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <!-- ==================== TENTANG KOTA ==================== -->
    <section class="py-16 max-w-6xl mx-auto px-4">
        <div
            class="flex flex-col lg:flex-row justify-between items-center gap-12"
        >
            <div class="flex-1">
                <h2 class="text-4xl font-bold tracking-tight mb-4">
                    <span class="text-primary">Tinggal</span> di Segara
                </h2>
                <p class="text-lg text-base-content/70 leading-relaxed mb-6">
                    Temukan kenyamanan dan keamanan tinggal di Kota Segara —
                    kota maritim modern yang memadukan kehidupan perkotaan
                    dengan harmoni alam. Dari kawasan hunian terjangkau hingga
                    kluster premium, setiap sudut dirancang untuk kualitas hidup
                    terbaik.
                </p>
                <div class="flex flex-wrap gap-3">
                    <div class="flex items-center gap-2">
                        <span class="text-primary">✓</span>
                        <span class="text-sm">Kawasan hunian terpadu</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-primary">✓</span>
                        <span class="text-sm">RTH & ruang publik</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-primary">✓</span>
                        <span class="text-sm">Keamanan 24 jam</span>
                    </div>
                </div>
                <div class="mt-8">
                    <a href="#" class="btn btn-primary">Jelajahi Kawasan</a>
                </div>
            </div>
            <div class="shrink-0">
                <Image
                    src={Jalan}
                    alt="Kawasan Kota Segara"
                    class="w-[500px] rounded-2xl shadow-2xl hover:scale-[1.02] transition-transform duration-300"
                />
            </div>
        </div>

        <div class="divider my-16"></div>

        <div
            class="flex flex-col lg:flex-row-reverse justify-between items-center gap-12"
        >
            <div class="flex-1">
                <h2 class="text-4xl font-bold tracking-tight mb-4">
                    <span class="text-primary">Belajar</span> di Segara
                </h2>
                <p class="text-lg text-base-content/70 leading-relaxed mb-6">
                    Wujudkan potensi terbaik di Kota Segara. Dengan fasilitas
                    pendidikan dari tingkat dasar hingga perguruan tinggi, kami
                    menyediakan lingkungan yang mendukung pertumbuhan dan
                    prestasi setiap individu.
                </p>
                <div class="flex flex-wrap gap-3">
                    <div class="flex items-center gap-2">
                        <span class="text-primary">✓</span>
                        <span class="text-sm">Sekolah negeri & swasta</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-primary">✓</span>
                        <span class="text-sm">Program beasiswa daerah</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-primary">✓</span>
                        <span class="text-sm">Pelatihan vokasi & kerja</span>
                    </div>
                </div>
                <div class="mt-8">
                    <a href="#" class="btn btn-primary">Jelajahi Pendidikan</a>
                </div>
            </div>
            <div class="shrink-0">
                <Image
                    src={Education}
                    alt="Pendidikan di Segara"
                    class="w-[500px] rounded-2xl shadow-2xl hover:scale-[1.02] transition-transform duration-300"
                />
            </div>
        </div>
    </section>

    <!-- ==================== BERITA TERBARU ==================== -->
    <section class="py-16 bg-base-200">
        <div class="max-w-6xl mx-auto px-4">
            <div class="flex justify-between items-end mb-10">
                <div>
                    <h2 class="text-4xl font-bold tracking-tight">
                        Berita <span class="text-primary">Terbaru</span>
                    </h2>
                    <p class="text-base-content/60 mt-1">
                        Liputan lengkap dari media mitra Kota Segara
                    </p>
                </div>
                <a href="/berita" class="btn btn-ghost btn-sm hidden sm:flex">
                    Arsip Berita →
                </a>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {
                    latestNews.map((news) => (
                        <a
                            href={`/berita/${news.id}`}
                            class="card bg-base-100 border border-base-200 shadow-sm hover:shadow-lg transition-all duration-300"
                        >
                            <div class="card-body">
                                <div class="flex gap-2 items-center mb-2 flex-wrap">
                                    <span
                                        class={`badge badge-sm ${badgeClass(news.data.category)}`}
                                    >
                                        {news.data.category}
                                    </span>
                                    <span class="text-xs text-base-content/50">
                                        {formatDate(news.data.date)}
                                    </span>
                                </div>
                                <h3 class="card-title text-base leading-snug">
                                    {news.data.title}
                                </h3>
                                <p class="text-sm text-base-content/70 line-clamp-2">
                                    {news.data.summary}
                                </p>
                            </div>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- ==================== CTA BANNER ==================== -->
    <section class="py-20">
        <div class="max-w-4xl mx-auto px-4 text-center">
            <h2 class="text-4xl font-bold tracking-tight mb-4">
                Siap Menjadi Bagian dari <span class="text-primary">Segara</span
                >?
            </h2>
            <p class="text-lg text-base-content/70 max-w-2xl mx-auto mb-8">
                Dapatkan informasi terbaru, layanan publik, dan berita seputar
                perkembangan Kota Segara langsung dari perangkat Anda.
            </p>
            <div class="flex gap-4 justify-center flex-wrap">
                <a href="#" class="btn btn-primary btn-lg">Hubungi Kami</a>
                <a href="#" class="btn btn-outline btn-lg">Temukan Kami</a>
            </div>
        </div>
    </section>
</Layout>
