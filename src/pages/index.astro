---
import Layout from "../layouts/Layout.astro";
import CityLandscape from "../assets/images/city-landscape-2031.webp";
import Education from "../assets/images/education.webp";
import Jalan from "../assets/images/jalan-pasir-putih-raya.webp";
import { Image } from "astro:assets";

import { getCollection } from "astro:content";
import StatCard from "../components/StatCard.astro";
import QuickLinkCard from "../components/QuickLinkCard.astro";
import NewsCard from "../components/NewsCard.astro";

const allNews = await getCollection("news");
const sortedNews = allNews.sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const latestNews = sortedNews.slice(0, 6);
---

<Layout
    title="Portal Resmi Kota Segara"
    description="Portal informasi resmi Pemerintah Kota Segara — kota maritim modern, nyaman untuk ditinggali, maju untuk berusaha."
>
    <!-- ==================== HERO SECTION ==================== -->

    <section
        class="bg-center bg-cover bg-no-repeat bg-gray-900/70 bg-blend-multiply min-h-screen flex flex-col justify-center items-center"
        style={`background-image: url('${CityLandscape.src}');`}
    >
        <div class="px-4 mx-auto max-w-7xl text-center py-12">
            <h1
                class="mb-6 text-4xl font-bold tracking-tighter text-white md:text-5xl lg:text-6xl"
            >
                Selamat Datang di Kota Segara
            </h1>
            <p
                class="mb-8 text-base font-normal text-white md:text-xl sm:px-16 lg:px-48"
            >
                Mari buat pengalaman tinggal mu menjadi lebih menarik dan
                menyenangkan, dengan dimulai segalanya di sini!
            </p>
        </div>
    </section>

    <!-- ==================== CITY STATS ==================== -->
    <section class="py-16 bg-base-200">
        <div class="max-w-6xl mx-auto px-4">
            <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
                <StatCard title="Populasi" value="5.000+" desc="±5.200 jiwa">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-8 w-8"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"
                        ></path>
                    </svg>
                </StatCard>
                <StatCard title="Distrik" value="4" desc="Masih Dalam Ekspansi">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-8 w-8"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
                        ></path>
                    </svg>
                </StatCard>
                <StatCard
                    title="Luas Wilayah"
                    value="42km"
                    desc="Termasuk perairan"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-8 w-8"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                    </svg>
                </StatCard>
            </div>
        </div>
    </section>

    <!-- ==================== CITY SERVICES ==================== -->
    <section class="py-16 bg-base-200">
        <div class="max-w-6xl mx-auto px-4">
            <div class="text-center mb-12">
                <h2 class="text-4xl font-bold tracking-tight">
                    Layanan <span class="text-primary">Publik</span>
                </h2>
                <p class="text-base-content/60 mt-1">
                    Akses cepat layanan pemerintahan Kota Segara
                </p>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                <QuickLinkCard
                    title="Transportasi"
                    link="/fasilitas/transportasi"
                    desc="Info trayek & jadwal"
                    iconBgColor="bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="1.5em"
                        height="1.5em"
                        viewBox="0 0 24 24"
                    >
                        <path d="M0 0h24v24H0z" fill="none"></path>
                        <path
                            fill="currentColor"
                            fill-rule="evenodd"
                            d="M12 2C8.229 2 6.343 2 5.172 3.172C4.108 4.235 4.01 5.886 4 9H3a1 1 0 0 0-1 1v1a1 1 0 0 0 .4.8L4 13c.01 3.114.108 4.765 1.172 5.828c.242.243.514.435.828.587V21a1 1 0 0 0 1 1h1.5a1 1 0 0 0 1-1v-1.018C10.227 20 11.054 20 12 20s1.773 0 2.5-.018V21a1 1 0 0 0 1 1H17a1 1 0 0 0 1-1v-1.585a3 3 0 0 0 .828-.587C19.892 17.765 19.991 16.114 20 13l1.6-1.2a1 1 0 0 0 .4-.8v-1a1 1 0 0 0-1-1h-1c-.01-3.114-.108-4.765-1.172-5.828C17.657 2 15.771 2 12 2M5.5 9.5c0 1.414 0 2.121.44 2.56c.439.44 1.146.44 2.56.44h7c1.414 0 2.121 0 2.56-.44c.44-.439.44-1.146.44-2.56V7c0-1.414 0-2.121-.44-2.56C17.622 4 16.915 4 15.5 4h-7c-1.414 0-2.121 0-2.56.44C5.5 4.878 5.5 5.585 5.5 7zm.75 6.5a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 0 1.5H7a.75.75 0 0 1-.75-.75m11.5 0a.75.75 0 0 0-.75-.75h-1.5a.75.75 0 0 0 0 1.5H17a.75.75 0 0 0 .75-.75"
                            clip-rule="evenodd"></path>
                    </svg>
                </QuickLinkCard>
                <QuickLinkCard
                    title="Kesehatan"
                    link="/"
                    desc="Puskesmas & RS"
                    iconBgColor="bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="1.5em"
                        height="1.5em"
                        viewBox="0 0 24 24"
                    >
                        <path d="M0 0h24v24H0z" fill="none"></path>
                        <path
                            fill="currentColor"
                            fill-rule="evenodd"
                            d="M21.5 8.5c0-1.404 0-2.107-.337-2.611a2 2 0 0 0-.552-.552c-.441-.295-1.034-.332-2.115-.336q.005.438.004.91V7.25h1a.75.75 0 0 1 0 1.5h-1v1.5h1a.75.75 0 0 1 0 1.5h-1v1.5h1a.75.75 0 0 1 0 1.5h-1v6.5H17V6c0-1.886 0-2.828-.586-3.414S14.886 2 13 2h-2c-1.886 0-2.828 0-3.414.586S7 4.114 7 6v15.25H5.5v-6.5h-1a.75.75 0 0 1 0-1.5h1v-1.5h-1a.75.75 0 0 1 0-1.5h1v-1.5h-1a.75.75 0 0 1 0-1.5h1V5.91q-.001-.47.004-.91c-1.081.005-1.674.042-2.115.337a2 2 0 0 0-.552.552C2.5 6.393 2.5 7.096 2.5 8.5v12.75H2a.75.75 0 0 0 0 1.5h20a.75.75 0 0 0 0-1.5h-.5zM12 4.25a.75.75 0 0 1 .75.75v1.25H14a.75.75 0 0 1 0 1.5h-1.25V9a.75.75 0 0 1-1.5 0V7.75H10a.75.75 0 0 1 0-1.5h1.25V5a.75.75 0 0 1 .75-.75M9.25 12a.75.75 0 0 1 .75-.75h4a.75.75 0 0 1 0 1.5h-4a.75.75 0 0 1-.75-.75m0 3a.75.75 0 0 1 .75-.75h4a.75.75 0 0 1 0 1.5h-4a.75.75 0 0 1-.75-.75M12 18.25a.75.75 0 0 1 .75.75v2.25h-1.5V19a.75.75 0 0 1 .75-.75"
                            clip-rule="evenodd"></path>
                    </svg>
                </QuickLinkCard>
                <QuickLinkCard
                    title="Pendidikan"
                    link="/fasilitas/pendidikan"
                    desc="Sekolah & Universitas"
                    iconBgColor="bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="1.5em"
                        height="1.5em"
                        viewBox="0 0 24 24"
                    >
                        <path d="M0 0h24v24H0z" fill="none"></path>
                        <path
                            fill="currentColor"
                            d="M5 13.18v2.81c0 .73.4 1.41 1.04 1.76l5 2.73c.6.33 1.32.33 1.92 0l5-2.73c.64-.35 1.04-1.03 1.04-1.76v-2.81l-6.04 3.3c-.6.33-1.32.33-1.92 0zm6.04-9.66l-8.43 4.6c-.69.38-.69 1.38 0 1.76l8.43 4.6c.6.33 1.32.33 1.92 0L21 10.09V16c0 .55.45 1 1 1s1-.45 1-1V9.59c0-.37-.2-.7-.52-.88l-9.52-5.19a2.04 2.04 0 0 0-1.92 0"
                        ></path>
                    </svg>
                </QuickLinkCard>
                <QuickLinkCard
                    title="Kebersihan"
                    link="/kebersihan"
                    desc="Jadwal dan Aduan"
                    iconBgColor="bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="1.5em"
                        height="1.5em"
                        viewBox="0 0 32 32"
                    >
                        <path d="M0 0h32v32H0z" fill="none"></path>
                        <path
                            fill="currentColor"
                            d="M4 1C2.348 1 1 2.348 1 4a3.01 3.01 0 0 0 2.112 2.866l2.243 18.628A3 3 0 0 0 4 28c0 1.652 1.348 3 3 3h18c1.652 0 3-1.348 3-3c0-1.07-.564-2.01-1.41-2.542l2.236-18.574A3.01 3.01 0 0 0 31 4c0-1.652-1.348-3-3-3zM3 4c0-.548.452-1 1-1h24c.548 0 1 .452 1 1s-.452 1-1 1H4c-.548 0-1-.452-1-1m22.972 3l-.636 5.275l-.332.632l-1.86-3.535L24.39 7zm-3.857 0l-.11.21l-.11-.21zm-2.497 0l1.248 2.375l-1.812 3.445l-1.904-3.619L18.308 7zm-3.594 0l-.016.03l-.016-.03zm-2.316 0l1.158 2.201l-1.904 3.62l-1.813-3.448L12.397 7zm-3.593 0l-.107.204L9.9 7zM7.616 7l1.25 2.377l-1.857 3.535l-.427-.812L5.968 7zm3.468 18H8.839l1.123-2.133zm6 0H14.93l1.077-2.048zm6.092 0H20.93l1.122-2.134zm.019-4.306l1.463-2.783l-.546 4.527zM7.26 17.732l1.558 2.963l-.977 1.859zm14.743-6.192l1.86 3.538l-1.812 3.444l-1.859-3.536zm-2.953 5.619l1.86 3.535l-1.904 3.62l-1.859-3.535zm-6.043 7.156l-1.904-3.62l1.858-3.532l1.904 3.62zm3-5.704l-1.904-3.62l1.904-3.618l1.904 3.62zm-6.046-.087l-1.814-3.447l1.859-3.533l1.813 3.448zM7 27h18c.548 0 1 .452 1 1s-.452 1-1 1H7c-.548 0-1-.452-1-1s.452-1 1-1"
                        ></path>
                    </svg>
                </QuickLinkCard>
                <QuickLinkCard
                    title="Rekreasi"
                    link="/fasilitas/rekreasi"
                    desc="Destinasi & Acara"
                    iconBgColor="bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="1.5em"
                        height="1.5em"
                        viewBox="0 0 28 28"
                    >
                        <path d="M0 0h28v28H0z" fill="none"></path>
                        <path
                            fill="currentColor"
                            d="M22.155 2.978A7.697 7.697 0 0 0 11.64 5.795l-.29.502a.75.75 0 0 0 .275 1.024l5.461 3.153l-3.268 5.72l-.068-.001c-3.158 0-5.893 1.832-7.522 4.422q.279-.1.586-.113a2 2 0 0 1 1.98 1.37c.595 1.798 2.767 1.7 3.315.107a2 2 0 0 1 3.782 0c.548 1.593 2.72 1.691 3.316-.108a2 2 0 0 1 1.994-1.368c-1.332-2.058-3.368-3.62-5.757-4.131l2.941-5.148l5.273 3.045a.75.75 0 0 0 1.025-.275l.29-.501a7.697 7.697 0 0 0-2.818-10.515M7.607 22.264a.75.75 0 0 0-1.44.058c-.255 1.042-.738 1.614-1.288 1.946c-.576.348-1.31.482-2.129.482a.75.75 0 0 0 0 1.5c.957 0 2-.152 2.904-.698a4 4 0 0 0 1.327-1.309c1.789 2.282 5.282 2.27 7.019-.024c1.765 2.33 5.34 2.306 7.103-.086a5.19 5.19 0 0 0 4.147 2.117a.75.75 0 1 0 0-1.5c-1.475 0-2.945-.96-3.43-2.478a.75.75 0 0 0-1.427-.008c-.963 2.909-4.738 2.872-5.684.121a.75.75 0 0 0-1.418 0c-.946 2.751-4.72 2.788-5.684-.12"
                        ></path>
                    </svg>
                </QuickLinkCard>
                <QuickLinkCard
                    title="Pengaduan"
                    link="/pengaduan"
                    desc="Lapor & Aspirasi"
                    iconBgColor="bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="1.5em"
                        height="1.5em"
                        viewBox="0 0 12 12"
                    >
                        <path d="M0 0h12v12H0z" fill="none"></path>
                        <path
                            fill="currentColor"
                            d="m5.966 4.49l-.827.742a5 5 0 0 0 .455 1.073a4.7 4.7 0 0 0 .722.922l1.071-.33c.6-.185 1.255.005 1.654.48l.61.726a1.47 1.47 0 0 1-.137 2.042c-.995.908-2.527 1.215-3.674.314a10.4 10.4 0 0 1-2.516-2.87A10 10 0 0 1 2.03 4.013c-.22-1.422.821-2.56 2.119-2.948c.774-.232 1.6.166 1.884.908l.335.875c.22.576.062 1.225-.402 1.641"
                        ></path>
                    </svg>
                </QuickLinkCard>
            </div>
        </div>
    </section>

    <!-- ==================== TENTANG KOTA ==================== -->
    <section class="py-16 max-w-6xl mx-auto px-4">
        <div
            class="flex flex-col lg:flex-row justify-between items-center gap-12"
        >
            <div class="flex-1">
                <h2 class="text-4xl font-bold tracking-tight mb-4">
                    <span class="text-primary">Tinggal</span> di Segara
                </h2>
                <p class="text-lg text-base-content/70 leading-relaxed mb-6">
                    Temukan kenyamanan dan keamanan tinggal di Kota Segara —
                    kota maritim modern yang memadukan kehidupan perkotaan
                    dengan harmoni alam. Dari kawasan hunian terjangkau hingga
                    kluster premium, setiap sudut dirancang untuk kualitas hidup
                    terbaik.
                </p>
                <div class="flex flex-wrap gap-3">
                    <span
                        class="bg-brand-softer text-fg-brand-strong text-xs font-medium px-1.5 py-0.5 rounded"
                        >✓ Kawasan Hunian Terpadu</span
                    >
                    <span
                        class="bg-brand-softer text-fg-brand-strong text-xs font-medium px-1.5 py-0.5 rounded"
                        >✓ RTH & Ruang Publik</span
                    >
                    <span
                        class="bg-brand-softer text-fg-brand-strong text-xs font-medium px-1.5 py-0.5 rounded"
                        >✓ Keamanan 24 Jam</span
                    >
                </div>
                <!-- <div class="mt-8">
                    <a href="#" class="btn btn-primary">Jelajahi Kawasan</a>
                </div> -->
            </div>
            <div class="shrink-0">
                <Image
                    src={Jalan}
                    alt="Kawasan Kota Segara"
                    class="w-[500px] rounded-2xl shadow-2xl hover:scale-[1.02] transition-transform duration-300"
                />
            </div>
        </div>

        <div class="divider my-16"></div>

        <div
            class="flex flex-col lg:flex-row-reverse justify-between items-center gap-12"
        >
            <div class="flex-1">
                <h2 class="text-4xl font-bold tracking-tight mb-4">
                    <span class="text-primary">Belajar</span> di Segara
                </h2>
                <p class="text-lg text-base-content/70 leading-relaxed mb-6">
                    Wujudkan potensi terbaik di Kota Segara. Dengan fasilitas
                    pendidikan dari tingkat dasar hingga perguruan tinggi, kami
                    menyediakan lingkungan yang mendukung pertumbuhan dan
                    prestasi setiap individu.
                </p>
                <div class="flex flex-wrap gap-3">
                    <span
                        class="bg-brand-softer text-fg-brand-strong text-xs font-medium px-1.5 py-0.5 rounded"
                        >✓ Sekolah Negeri & Swasta</span
                    >
                    <span
                        class="bg-brand-softer text-fg-brand-strong text-xs font-medium px-1.5 py-0.5 rounded"
                        >✓ Lingkungan Pendidikan</span
                    >
                    <span
                        class="bg-brand-softer text-fg-brand-strong text-xs font-medium px-1.5 py-0.5 rounded"
                        >✓ Dukungan Penuh Dari Pemerintah</span
                    >
                </div>
                <!-- <div class="mt-8">
                    <a href="#" class="btn btn-primary">Jelajahi Pendidikan</a>
                </div> -->
            </div>
            <div class="shrink-0">
                <Image
                    src={Education}
                    alt="Pendidikan di Segara"
                    class="w-[500px] rounded-2xl shadow-2xl hover:scale-[1.02] transition-transform duration-300"
                />
            </div>
        </div>
    </section>

    <!-- ==================== BERITA TERBARU ==================== -->
    <section class="py-16 bg-base-200">
        <div class="max-w-6xl mx-auto px-4">
            <div class="flex justify-between items-end mb-10">
                <div>
                    <h2 class="text-4xl font-bold tracking-tight">
                        Berita <span class="text-primary">Terbaru</span>
                    </h2>
                    <p class="text-base-content/60 mt-1">
                        Liputan lengkap dari media mitra Kota Segara
                    </p>
                </div>
                <a
                    href="/berita"
                    class="inline-flex items-center text-white bg-brand hover:bg-brand-strong box-border border border-transparent focus:ring-4 focus:ring-brand-medium shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none"
                >
                    Berita Lainnya
                    <svg
                        class="w-4 h-4 ms-1.5 -me-0.5"
                        aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        fill="none"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke="currentColor"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 12H5m14 0-4 4m4-4-4-4"></path>
                    </svg>
                </a>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {
                    latestNews.map((news) => (
                        <NewsCard
                            id={news.id}
                            category={news.data.category}
                            title={news.data.title}
                            date={news.data.date}
                            summary={news.data.summary}
                        />
                    ))
                }
            </div>
        </div>
    </section>
</Layout>
