---
import Layout from "../../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const news = await getCollection("news");
  return news.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const { title, date, category, summary, tags, image } = entry.data;

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString("id-ID", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

function badgeClass(category: string): string {
  if (category === "Infrastruktur") return "badge-info";
  if (category === "Sosial") return "badge-warning";
  if (category === "Transportasi") return "badge-secondary";
  if (category === "Ekonomi") return "badge-success";
  if (category === "Pemerintah") return "badge-accent";
  if (category === "Politik & Pemerintahan") return "badge-accent";
  if (category === "Lingkungan") return "badge-success";
  if (category === "Tata Kota") return "badge-info";
  return "badge-ghost";
}
---

<Layout title={`${title} — Kota Segara`} description={summary || title}>
  <!-- Breadcrumb -->
  <section class="bg-base-200 border-b border-base-300">
    <div class="max-w-3xl mx-auto px-4 py-6">
      <div class="breadcrumbs text-sm text-base-content/60">
        <ul>
          <li>
            <a href="/" class="hover:text-primary transition-colors">Beranda</a>
          </li>
          <li>
            <a href="/berita" class="hover:text-primary transition-colors"
              >Berita</a
            >
          </li>
          <li class="text-base-content/40 truncate max-w-[200px] sm:max-w-xs">
            {title}
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Featured image -->
  {
    image && (
      <div class="max-w-5xl mx-auto px-4 -mt-1">
        <img
          src={image}
          alt={title}
          class="w-full h-64 md:h-96 object-cover rounded-b-2xl shadow-lg"
        />
      </div>
    )
  }

  <!-- Article -->
  <article class="max-w-3xl mx-auto px-4 py-10">
    <!-- Meta -->
    <div class="flex items-center gap-3 mb-4 flex-wrap">
      <span class={`badge badge-md ${badgeClass(category)}`}>{category}</span>
      <time class="text-sm text-base-content/50" datetime={date}>
        {formatDate(date)}
      </time>
    </div>

    <!-- Title -->
    <h1
      class="text-4xl md:text-5xl font-bold tracking-tight leading-tight mb-6"
    >
      {title}
    </h1>

    <!-- Summary -->
    {
      summary && (
        <p class="text-lg text-base-content/70 leading-relaxed mb-8 border-l-4 border-primary pl-4 italic">
          {summary}
        </p>
      )
    }

    <!-- Tags -->
    {
      tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8">
          {tags.map((tag) => (
            <span class="badge badge-ghost badge-sm">{tag}</span>
          ))}
        </div>
      )
    }

    <div class="divider"></div>

    <!-- Content -->
    <div class="prose prose-lg max-w-none dark:prose-invert mb-12">
      <Content />
    </div>

    <!-- Navigation -->
    <div class="divider"></div>
    <div class="flex justify-between items-center">
      <a href="/berita" class="btn btn-ghost btn-sm gap-2">
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M7 16l-4-4m0 0l4-4m-4 4h18"></path>
        </svg>
        Kembali ke Berita
      </a>
      <a href="/" class="btn btn-ghost btn-sm gap-2">
        Ke Beranda
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </article>
</Layout>

<style is:global>
  .prose h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .prose h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose p {
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .prose blockquote {
    border-left: 4px solid var(--color-primary);
    background-color: color-mix(
      in srgb,
      var(--color-base-200) 50%,
      transparent
    );
    padding: 0.75rem 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    border-radius: 0 var(--radius-box, 1rem) var(--radius-box, 1rem) 0;
    font-style: italic;
  }
  .prose blockquote p {
    margin-bottom: 0;
  }
  .prose ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
  .prose ul li {
    margin-bottom: 0.25rem;
  }
  .prose strong {
    font-weight: 600;
  }
  .prose hr {
    margin-top: 2rem;
    margin-bottom: 2rem;
  }
  .prose img {
    border-radius: 0.75rem;
    box-shadow:
      0 4px 6px -1px rgb(0 0 0 / 0.1),
      0 2px 4px -2px rgb(0 0 0 / 0.1);
    margin-top: 2rem;
    margin-bottom: 2rem;
    max-width: 100%;
  }
  .prose a {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .prose a:hover {
    opacity: 0.8;
  }
</style>
