---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const news = await getCollection("news");
    return news.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const { title, date, category, summary, tags, image } = entry.data;

function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString("id-ID", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
}

function badgeClass(category: string): string {
    switch (category) {
        case "Infrastruktur":
        case "Tata Kota":
            return "bg-cyan-100 text-cyan-800 dark:bg-cyan-900/40 dark:text-cyan-300 border-cyan-200 dark:border-cyan-800";
        case "Sosial":
            return "bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300 border-amber-200 dark:border-amber-800";
        case "Transportasi":
            return "bg-purple-100 text-purple-800 dark:bg-purple-900/40 dark:text-purple-300 border-purple-200 dark:border-purple-800";
        case "Ekonomi":
        case "Lingkungan":
            return "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800";
        case "Pemerintah":
        case "Politik & Pemerintahan":
            return "bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300 border-blue-200 dark:border-blue-800";
        default:
            return "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300 border-gray-200 dark:border-gray-600";
    }
}
---

<Layout title={`${title} — Kota Segara`} description={summary || title}>
    <!-- Breadcrumb -->
    <section
        class="bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 transition-colors duration-200 mt-20"
    >
        <div class="max-w-3xl mx-auto px-4 py-4">
            <nav
                class="flex text-sm text-gray-500 dark:text-gray-400"
                aria-label="Breadcrumb"
            >
                <ol
                    class="inline-flex items-center space-x-1 md:space-x-2 flex-wrap"
                >
                    <li class="inline-flex items-center">
                        <a
                            href="/"
                            class="inline-flex items-center hover:text-blue-600 dark:hover:text-white transition-colors"
                        >
                            <svg
                                class="w-3.0 h-3.0 mr-1.5"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l1.293 1.293a1 1 0 001.414-1.414l-7-7z"
                                ></path>
                            </svg>
                            Beranda
                        </a>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <svg
                                class="w-3 h-3 text-gray-400 mx-1"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 5l7 7-7 7"></path>
                            </svg>
                            <a
                                href="/berita"
                                class="hover:text-blue-600 dark:hover:text-white transition-colors"
                                >Berita</a
                            >
                        </div>
                    </li>
                    <li aria-current="page">
                        <div class="flex items-center">
                            <svg
                                class="w-3 h-3 text-gray-400 mx-1"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 5l7 7-7 7"></path>
                            </svg>
                            <span
                                class="text-gray-400 dark:text-gray-500 truncate max-w-45 sm:max-w-xs"
                                >{title}</span
                            >
                        </div>
                    </li>
                </ol>
            </nav>
        </div>
    </section>

    <!-- Featured image -->
    {
        image && (
            <div class="max-w-4xl mx-auto px-4 mt-6">
                <img
                    src={image}
                    alt={title}
                    class="w-full h-64 md:h-96 object-cover rounded-2xl shadow-md border border-gray-200 dark:border-gray-800"
                />
            </div>
        )
    }

    <!-- Article -->
    <article class="max-w-3xl mx-auto px-4 py-8">
        <!-- Meta (Kategori & Tanggal) -->
        <div class="flex items-center gap-3 mb-4 flex-wrap">
            <span
                class={`text-xs font-semibold px-2.5 py-0.5 rounded-md border ${badgeClass(category)}`}
            >
                {category}
            </span>
            <time
                class="text-sm text-gray-500 dark:text-gray-400"
                datetime={date}
            >
                {formatDate(date)}
            </time>
        </div>

        <!-- Title -->
        <h1
            class="text-3xl md:text-5xl font-extrabold tracking-tight text-gray-900 dark:text-white leading-tight mb-6"
        >
            {title}
        </h1>

        <!-- Summary / Lead Paragraph -->
        {
            summary && (
                <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed mb-8 border-l-4 border-blue-600 dark:border-blue-500 pl-4 italic bg-blue-50/50 dark:bg-blue-900/10 py-2 rounded-r-lg">
                    {summary}
                </p>
            )
        }

        <!-- Tags -->
        {
            tags && tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-8">
                    {tags.map((tag) => (
                        <span class="bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 text-xs font-medium px-2.5 py-1 rounded-full border border-gray-200 dark:border-gray-700">
                            #{tag}
                        </span>
                    ))}
                </div>
            )
        }

        <!-- Divider -->
        <hr class="border-gray-200 dark:border-gray-800 my-8" />

        <!-- Content (Markdown Render) -->
        <div
            class="prose prose-lg max-w-none dark:prose-invert mb-12 text-gray-800 dark:text-gray-200"
        >
            <Content />
        </div>

        <!-- Navigation Bar Bawah -->
        <hr class="border-gray-200 dark:border-gray-800 my-8" />
        <div class="flex justify-between items-center flex-wrap gap-4">
            <a
                href="/berita"
                class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors shadow-xs"
            >
                <svg
                    class="w-4 h-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M7 16l-4-4m0 0l4-4m-4 4h18"></path>
                </svg>
                Kembali ke Berita
            </a>

            <a
                href="/"
                class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-blue-700 hover:bg-blue-800 dark:bg-blue-600 dark:hover:bg-blue-700 rounded-xl transition-colors shadow-xs"
            >
                Ke Beranda
                <svg
                    class="w-4 h-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
            </a>
        </div>
    </article>
</Layout>

<style is:global>
    /* Styling Artikel Markdown Tanpa DaisyUI */
    .prose h2 {
        color: var(--tw-prose-headings, inherit);
        font-size: 1.625rem;
        font-weight: 700;
        margin-top: 2.25rem;
        margin-bottom: 1rem;
        line-height: 1.3;
    }
    .prose h3 {
        color: var(--tw-prose-headings, inherit);
        font-size: 1.35rem;
        font-weight: 600;
        margin-top: 1.75rem;
        margin-bottom: 0.75rem;
    }
    .prose p {
        line-height: 1.8;
        margin-bottom: 1.25rem;
    }
    .prose blockquote {
        border-left: 4px solid #2563eb; /* Blue-600 */
        background-color: rgba(37, 99, 235, 0.05);
        padding: 1rem 1.25rem;
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
        border-radius: 0 0.75rem 0.75rem 0;
        font-style: italic;
    }
    .dark .prose blockquote {
        background-color: rgba(30, 58, 138, 0.2);
    }
    .prose blockquote p {
        margin-bottom: 0;
    }
    .prose ul {
        list-style-type: disc;
        padding-left: 1.5rem;
        margin-bottom: 1.25rem;
    }
    .prose ul li {
        margin-bottom: 0.375rem;
    }
    .prose strong {
        font-weight: 700;
    }
    .prose hr {
        border-color: rgba(156, 163, 175, 0.2);
        margin-top: 2rem;
        margin-bottom: 2rem;
    }
    .prose img {
        border-radius: 1rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        margin-top: 2rem;
        margin-bottom: 2rem;
        width: 100%;
    }
    .prose a {
        color: #2563eb;
        text-decoration: underline;
        font-weight: 500;
    }
    .dark .prose a {
        color: #60a5fa;
    }
    .prose a:hover {
        opacity: 0.85;
    }
</style>
