---
import Layout from "../../layouts/Layout.astro";
import NewsCard from "../../components/NewsCard.astro";
import { getCollection } from "astro:content";
import Header from "../../components/Header.astro";

const allNews = await getCollection("news");
const sortedNews = allNews.sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const categories = [...new Set(sortedNews.map((n) => n.data.category))];
---

<Layout
    title="Berita — Kota Segara"
    description="Kumpulan berita dan informasi terbaru seputar perkembangan Kota Segara."
>
    <!-- Header -->
    <Header
        title="Berita"
        description="Informasi dan perkembangan terbaru seputar Kota Segara — liputan dari media independen dan rilis resmi pemerintah."
    />

    <!-- Headline -->
    <section class="max-w-6xl mx-auto px-4 py-12">
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
            <span class="text-primary">Terhangat</span>
            <span class="badge badge-primary badge-sm">Headline</span>
        </h2>

        <div class="grid md:grid-cols-2 gap-6">
            {
                sortedNews
                    .filter((n) => n.data.isHeadline)
                    .slice(0, 2)
                    .map((news) => (
                        <NewsCard
                            id={news.id}
                            category={news.data.category}
                            title={news.data.title}
                            date={news.data.date}
                            image={news.data.image}
                            summary={news.data.summary}
                            isHeadline={true}
                        />
                    ))
            }
        </div>
    </section>

    <section class="max-w-6xl mx-auto px-4 pb-16">
        <h2 class="text-2xl font-bold mb-6">Semua Berita</h2>

        <div id="category-filters" class="flex flex-wrap gap-2 mb-8">
            <button
                type="button"
                data-category="all"
                class="filter-btn px-4 py-2 text-sm font-medium rounded-full transition-colors duration-200 bg-blue-700 text-white dark:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
                Semua
            </button>

            {
                categories.map((cat) => (
                    <button
                        type="button"
                        data-category={cat}
                        class="filter-btn px-4 py-2 text-sm font-medium rounded-full transition-colors duration-200 text-gray-700 bg-gray-100 hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700 dark:hover:text-white border border-gray-200 dark:border-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    >
                        {cat}
                    </button>
                ))
            }
        </div>

        <!-- News grid -->
        <div id="news-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
                sortedNews.map((news) => (
                    <NewsCard
                        id={news.id}
                        category={news.data.category}
                        title={news.data.title}
                        date={news.data.date}
                        image={news.data.image}
                        summary={news.data.summary}
                        tags={news.data.tags}
                    />
                ))
            }
        </div>
    </section>
</Layout>
<script is:inline>
    const ITEMS_PER_PAGE = 9;
    const grid = document.getElementById("news-grid");
    const allCards = Array.from(grid.querySelectorAll(":scope > a"));
    const filterButtons = document.querySelectorAll("#category-filters button");

    let currentPage = 1;
    let activeCategory = "all";

    const sentinel = document.createElement("div");
    sentinel.id = "scroll-sentinel";
    sentinel.className =
        "flex items-center justify-center gap-2 py-8 text-sm font-medium text-gray-500 dark:text-gray-400";
    sentinel.innerHTML = `
      <svg class="w-5 h-5 animate-spin text-blue-600 dark:text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span>Memuat berita lainnya...</span>
    `;
    grid.after(sentinel);

    function getFilteredCards() {
        if (activeCategory === "all") return allCards;
        return allCards.filter((c) => c.dataset.category === activeCategory);
    }

    function showItems() {
        const filtered = getFilteredCards();
        const limit = currentPage * ITEMS_PER_PAGE;
        const toShow = filtered.slice(0, limit);

        allCards.forEach((c) => {
            c.style.display = toShow.includes(c) ? "" : "none";
        });

        sentinel.style.display =
            toShow.length >= filtered.length ? "none" : "flex";
    }

    // Infinite scroll via IntersectionObserver
    const observer = new IntersectionObserver(
        (entries) => {
            if (entries[0].isIntersecting) {
                currentPage++;
                showItems();
            }
        },
        { rootMargin: "200px" },
    );
    observer.observe(sentinel);

    filterButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
            activeCategory = btn.dataset.category;
            currentPage = 1;

            filterButtons.forEach((b) => {
                b.classList.remove(
                    "bg-blue-700",
                    "text-white",
                    "dark:bg-blue-600",
                );
                b.classList.add(
                    "text-gray-700",
                    "bg-gray-100",
                    "hover:bg-gray-200",
                    "dark:bg-gray-800",
                    "dark:text-gray-300",
                    "dark:hover:bg-gray-700",
                    "dark:hover:text-white",
                );
            });

            btn.classList.remove(
                "text-gray-700",
                "bg-gray-100",
                "hover:bg-gray-200",
                "dark:bg-gray-800",
                "dark:text-gray-300",
                "dark:hover:bg-gray-700",
                "dark:hover:text-white",
            );
            btn.classList.add("bg-blue-700", "text-white", "dark:bg-blue-600");

            showItems();
        });
    });

    showItems();
</script>
