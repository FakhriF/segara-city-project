---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allNews = await getCollection("news");
const sortedNews = allNews.sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const categories = [...new Set(sortedNews.map((n) => n.data.category))];

function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString("id-ID", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
}

function badgeClass(category: string): string {
    if (category === "Infrastruktur") return "badge-info";
    if (category === "Sosial") return "badge-warning";
    if (category === "Transportasi") return "badge-secondary";
    if (category === "Ekonomi") return "badge-success";
    if (category === "Pemerintah") return "badge-accent";
    if (category === "Politik & Pemerintahan") return "badge-accent";
    if (category === "Lingkungan") return "badge-success";
    if (category === "Tata Kota") return "badge-info";
    return "badge-ghost";
}
---

<Layout
    title="Berita — Kota Segara"
    description="Kumpulan berita dan informasi terbaru seputar perkembangan Kota Segara."
>
    <!-- Header -->
    <section class="bg-base-200 border-b border-base-300">
        <div class="max-w-6xl mx-auto px-4 py-16 md:py-24">
            <div class="max-w-2xl">
                <h1 class="text-5xl font-bold tracking-tight mb-3">
                    Berita <span class="text-primary">Segara</span>
                </h1>
                <p class="text-lg text-base-content/70">
                    Informasi dan perkembangan terbaru seputar Kota Segara —
                    liputan dari media independen dan rilis resmi pemerintah.
                </p>
            </div>
        </div>
    </section>

    <!-- Headline -->
    <section class="max-w-6xl mx-auto px-4 py-12">
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
            <span class="text-primary">Terhangat</span>
            <span class="badge badge-primary badge-sm">Headline</span>
        </h2>

        <div class="grid md:grid-cols-2 gap-6">
            {
                sortedNews
                    .filter((n) => n.data.isHeadline)
                    .slice(0, 2)
                    .map((news) => (
                        <a
                            href={`/berita/${news.id}`}
                            class="card bg-base-100 border border-base-200 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 group"
                        >
                            {news.data.image && (
                                <figure class="h-48 overflow-hidden">
                                    <img
                                        src={news.data.image}
                                        alt={news.data.title}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                    />
                                </figure>
                            )}
                            <div class="card-body p-6">
                                <div class="flex items-center gap-2 mb-3">
                                    <span
                                        class={`badge badge-sm ${badgeClass(news.data.category)}`}
                                    >
                                        {news.data.category}
                                    </span>
                                    <span class="text-xs text-base-content/50">
                                        {formatDate(news.data.date)}
                                    </span>
                                </div>
                                <h3 class="card-title text-xl group-hover:text-primary transition-colors">
                                    {news.data.title}
                                </h3>
                                <p class="text-base text-base-content/70 line-clamp-3">
                                    {news.data.summary}
                                </p>
                                <div class="mt-4 flex items-center gap-2 text-sm text-primary font-medium">
                                    Baca selengkapnya
                                    <svg
                                        class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M17 8l4 4m0 0l-4 4m4-4H3"
                                        />
                                    </svg>
                                </div>
                            </div>
                        </a>
                    ))
            }
        </div>
    </section>

    <!-- All news -->
    <section class="max-w-6xl mx-auto px-4 pb-16">
        <h2 class="text-2xl font-bold mb-6">Semua Berita</h2>

        <!-- Category filter tabs -->
        <div id="category-filters" class="flex flex-wrap gap-2 mb-8">
            <button data-category="all" class="btn btn-sm btn-primary"
                >Semua</button
            >
            {
                categories.map((cat) => (
                    <button data-category={cat} class="btn btn-sm btn-ghost">
                        {cat}
                    </button>
                ))
            }
        </div>

        <!-- News grid -->
        <div id="news-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
                sortedNews.map((news) => (
                    <a
                        href={`/berita/${news.id}`}
                        data-category={news.data.category}
                        class="card bg-base-100 border border-base-200 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5 group"
                    >
                        {news.data.image && (
                            <figure class="h-40 overflow-hidden rounded-t-box">
                                <img
                                    src={news.data.image}
                                    alt={news.data.title}
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                />
                            </figure>
                        )}
                        <div class="card-body p-5">
                            <div class="flex items-center gap-2 mb-2 flex-wrap">
                                <span
                                    class={`badge badge-sm ${badgeClass(news.data.category)}`}
                                >
                                    {news.data.category}
                                </span>
                                <span class="text-xs text-base-content/50">
                                    {formatDate(news.data.date)}
                                </span>
                            </div>
                            <h3 class="card-title text-base leading-snug group-hover:text-primary transition-colors">
                                {news.data.title}
                            </h3>
                            <p class="text-sm text-base-content/70 line-clamp-2">
                                {news.data.summary}
                            </p>
                            {news.data.tags && news.data.tags.length > 0 && (
                                <div class="flex flex-wrap gap-1.5 mt-3">
                                    {news.data.tags.slice(0, 3).map((tag) => (
                                        <span class="badge badge-ghost badge-xs">
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                            )}
                        </div>
                    </a>
                ))
            }
        </div>
    </section>
    <script is:inline>
        const filterButtons = document.querySelectorAll(
            "#category-filters button",
        );
        const newsCards = document.querySelectorAll("#news-grid a");

        filterButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
                const category = btn.dataset.category;

                filterButtons.forEach((b) => {
                    b.classList.remove("btn-primary");
                    b.classList.add("btn-ghost");
                });
                btn.classList.remove("btn-ghost");
                btn.classList.add("btn-primary");

                newsCards.forEach((card) => {
                    if (
                        category === "all" ||
                        card.dataset.category === category
                    ) {
                        card.style.display = "";
                    } else {
                        card.style.display = "none";
                    }
                });
            });
        });
    </script>
</Layout>
